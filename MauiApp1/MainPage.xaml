<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiApp1.ViewModels"
             xmlns:model="clr-namespace:MauiApp1.Models"
             x:Class="MauiApp1.MainPage"
             Title="Nuestro Catálogo de Pizzas">

	<ContentPage.BindingContext>
		<local:MainPageViewModel />
	</ContentPage.BindingContext>

	<ScrollView>
		<VerticalStackLayout Padding="30,0" Spacing="25">
			<Image Source="casera.jpg"
                   HeightRequest="100"
                   Aspect="AspectFit"
                   SemanticProperties.Description="dot net bot mascot"
                   HorizontalOptions="Center" />

            <Label Text="Explora nuestras deliciosas pizzas"
                   Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,10,0,10" />

			<CollectionView ItemsSource="{Binding Pizzas}"
                            Margin="0,20,0,0">
				<CollectionView.ItemsLayout>
					 <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="model:Pizza">
						<Border BackgroundColor="{AppThemeBinding Light=White, Dark=DarkGray}"
                                Stroke="{AppThemeBinding Light=LightGray, Dark=Gray}"
                                StrokeThickness="1"
                                Padding="15"
                                Margin="0,5"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="FillAndExpand">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="10" />
							</Border.StrokeShape>
							<Border.Shadow>
								<Shadow Brush="Black" Offset="5,5" Radius="10" Opacity="0.3" />
							</Border.Shadow>
							<VerticalStackLayout Spacing="10">
								<Image Source="{Binding Image}"
                                       HeightRequest="120"
                                       Aspect="AspectFill"
                                       HorizontalOptions="CenterAndExpand" />

								<Label Text="{Binding Name}"
                                       FontSize="Title"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />

								<Label Text="{Binding Description}"
                                       FontSize="Small"
                                       TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}"
                                       HorizontalTextAlignment="Center" />

                                <Label Text="{Binding amount, StringFormat='Código: {0}'}"
                                       FontSize="Micro"
                                       FontAttributes="Italic"
                                       HorizontalTextAlignment="Center" />

								<Button Text="¡Pedir ahora!"
                                        BackgroundColor="Green"
                                        TextColor="White"
                                        CornerRadius="5"
                                        Margin="0,10,0,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPageViewModel}}, Path=OrderPizzaCommand}"
                                        CommandParameter="{Binding .}"
                                        HorizontalOptions="Fill" />
							</VerticalStackLayout>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>