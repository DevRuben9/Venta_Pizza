<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1.Views"
    Shell.FlyoutBehavior="Flyout"
    xmlns:main="clr-namespace:MauiApp1"
    Title="MauiApp1">

    <Shell.FlyoutHeader>
        <Grid BackgroundColor="LightBlue" HeightRequest="150">
            <Label Text="Mi Aplicación de Pizzas"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>
    <FlyoutItem Title="Inicio" Icon="pizza_menu_icon.png" Route="MainPage">
        <ShellContent
            Title="Catálogo de Pizzas"
            Icon="pizza_menu_icon.png"
            ContentTemplate="{DataTemplate main:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Ventas" Icon="sale_icon.png" Route="VentasPage">
        <ShellContent
            Title="Ventas"
            Icon="sale_icon.png"  ContentTemplate="{DataTemplate local:VentasPage}"
            Route="VentasPage" />
    </FlyoutItem>

    <FlyoutItem Title="Inventario" Icon="inventory_icon.png" Route="InventarioPage">
        <ShellContent
            Title="Inventarios"
            Icon="inventory_icon.png"  ContentTemplate="{DataTemplate local:InventarioPage}"
            Route="InventarioPage" />
    </FlyoutItem>

</Shell>
