<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.VentasPage"
             Title="VentasPage">
    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <!-- Input de Nombre -->
            <Label Text="Pizza" FontAttributes="Bold" />
            <Entry Placeholder="Ingresa tu nombre" />

            <!-- Input de texto -->
            <Label Text="Nombre del Cliente" FontAttributes="Bold" />
            <Entry Placeholder="Ingresa tu nombre" />

            <!-- Input numérico -->
            <Label Text="Edad" FontAttributes="Bold" />
            <Entry Placeholder="Ingresa tu edad" Keyboard="Numeric" />

            <!-- RadioButtons (por ejemplo, tamaño de pizza) -->
            <Label Text="Tamaño de Pizza" FontAttributes="Bold" />
            <RadioButton Content="Mediana" GroupName="tamaño" Value="Mediana" />
            <RadioButton Content="Grande" GroupName="tamaño" Value="Grande" />

            <!-- CheckBoxes (por ejemplo, ingredientes extra) -->
            <Label Text="Ingredientes Extra" FontAttributes="Bold" />
            <CheckBox x:Name="ChkQueso" />
            <Label Text="Queso adicional" />
            <CheckBox x:Name="ChkPeperoni" />
            <Label Text="Peperoni" />

            <!-- Picker (por ejemplo, método de pago) -->
            <Label Text="Método de Pago" FontAttributes="Bold" />
            <Picker Title="Selecciona un método">
                <Picker.Items>
                    <x:String>Efectivo</x:String>
                    <x:String>Tarjeta</x:String>
                    <x:String>Transferencia</x:String>
                </Picker.Items>
            </Picker>

            <!-- Botón de envío -->
            <Button Text="Enviar"
                    BackgroundColor="LightBlue"
                    TextColor="White"
                    />

        </StackLayout>
    </ScrollView>
</ContentPage>