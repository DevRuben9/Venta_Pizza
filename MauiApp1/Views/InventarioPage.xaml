<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:MauiApp1.Behaviors"
             xmlns:local="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.Views.InventarioPage"
             Title="InventarioPage">

    <ScrollView>
        <StackLayout Padding="10" Spacing="15">

            <VerticalStackLayout Padding="20" Spacing="15">
                <!-- Picker (por ejemplo, método de pago) -->
                <Label Text="Tipo de Pizza" FontAttributes="Bold" />
                <Picker Title="Selecciona Tipo"
                        ItemsSource="{Binding TiposDePizza}"
                        SelectedItem="{Binding TipoProductoSeleccionado}">
                    <Picker.Items>
                        <x:String>Pizza Grande</x:String>
                        <x:String>Pizza Especiales</x:String>
                        <x:String>Pizza Mediano</x:String>
                        <x:String>Pizza Pequeño</x:String>
                        <x:String>Pizza Mediano Especial</x:String>
                    </Picker.Items>
                </Picker>

                <!-- Input numérico -->
                <Label Text="Cantidad" FontAttributes="Bold" />
                <Entry x:Name="CantidadEntry" Text="{Binding CantidadProducto}" Placeholder="Ingresa Cantidad" Keyboard="Numeric" />

                <!-- Botón de envío -->
                <Button Text="Agregar"
                    Command="{Binding addProductoCommand}"
                    BackgroundColor="#198754"
                    TextColor="White"
                    CornerRadius="20"
                    >
                    <Button.Behaviors>
                        <behaviors:ButtonHoverBehavior
                        NormalColor="#198754"  HoverColor="#157347" />
                    </Button.Behaviors>
                </Button>
            </VerticalStackLayout>

            <CollectionView ItemsSource="{Binding Productos}">
                <CollectionView.Header>
                    <Grid ColumnDefinitions="0.1*,0.3*,0.2*,0.1*,0.1*" Padding="5">
                        <Label Grid.Column="0" Text="ID" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="Nombre" FontAttributes="Bold" />
                        <Label Grid.Column="2" Text="Cantidad" FontAttributes="Bold" />
                        <Label Grid.Column="3" Text="Editar" FontAttributes="Bold" />
                        <Label Grid.Column="4" Text="" FontAttributes="Bold" />
                    </Grid>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="0.1*,0.3*,0.2*,0.1*,0.1*" Padding="5">
                            <Label Grid.Column="0" Text="{Binding Id}" />
                            <Label Grid.Column="1" Text="{Binding Nombre}" />
                            <Label Grid.Column="2" Text="{Binding Cantidad}" />
                            
                            <!-- Estado con Checkbox -->
                            <CheckBox Grid.Column="3" IsChecked="{Binding Estado, Mode=TwoWay}" />

                            <!-- Botón Modificar -->
                            <Button Grid.Column="4" Text="✏️"
                                Command="{Binding ModificarCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="Orange"
                                WidthRequest="40"
                                HeightRequest="40"
                                CornerRadius="20" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
        </StackLayout>
    </ScrollView>
</ContentPage>